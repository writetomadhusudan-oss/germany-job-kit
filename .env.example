# ---- Payment provider: dodo | stripe | paddle | gumroad
PAYMENT_PROVIDER=dodo

# ---- Dodo Payments (default provider) ----
# API key: Dodo Dashboard → Developer → API → create a key.
# Use a TEST key while testing (DODO_PAYMENTS_ENVIRONMENT=test_mode).
DODO_PAYMENTS_API_KEY=
# Product id of your €5.99 ONE-TIME product: Dodo Dashboard → Products.
# Looks like "pdt_...".
# One Dodo product per region currency (each issues the same Global Job Kit
# license). Create five products:
#   EUR → €5.99  CAD → CAD 7.99  AUD → AUD 8.99  GBP → £4.99  INR → ₹499
DODO_PRODUCT_ID=
DODO_PRODUCT_ID_EUR=
DODO_PRODUCT_ID_CAD=
DODO_PRODUCT_ID_AUD=
DODO_PRODUCT_ID_GBP=
DODO_PRODUCT_ID_INR=
# test_mode (sandbox) or live_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Webhook secret: Dodo Dashboard → Developer → Webhooks → your endpoint →
# copy the webhook secret. Subscribe the endpoint to "payment.succeeded".
# The endpoint URL is: https://YOUR-APP-DOMAIN/api/webhook
DODO_PAYMENTS_WEBHOOK_SECRET=

# ---- Stripe (only needed when PAYMENT_PROVIDER=stripe) ----
# Note: as of 2026 Stripe India is invite-only for new merchants; Dodo is
# the default for Indian sellers for this reason.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---- Paddle / Gumroad fallback (only when PAYMENT_PROVIDER=paddle|gumroad) ----
# Create a €5.99 one-time product in the provider dashboard and paste its
# payment link here. Set the provider's post-payment redirect URL to:
#   https://YOUR-APP-DOMAIN/success?order_id={order_id}
# (use the provider's template variable for the order id if supported)
PROVIDER_CHECKOUT_URL=
# Shared secret used to HMAC-sign the provider's webhook posts
# (header X-Webhook-Signature). See README "Webhooks" section.
PROVIDER_WEBHOOK_SECRET=

# Base URL of this app (used for Dodo/Stripe success/cancel URLs)
APP_BASE_URL=http://localhost:8000

# Signs the unlock cookie. Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me

# SQLite for dev (file in working dir). For Postgres in prod set e.g.
# postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./germany_job_kit.db

# true = skip the paywall (local testing only — never in production)
DEV_BYPASS_PAYWALL=false
